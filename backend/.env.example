# FastAPI
HOST=0.0.0.0
PORT=8000
DEBUG=false

# 本地数据库（SQLite）
LOCAL_DB_URL=sqlite:///./data/dashboard.db

# ERP 数据库连接（只读）
ERP_DB_HOST=your-rds-host.aliyuncs.com
ERP_DB_PORT=3306
ERP_DB_USER=readonly_user
ERP_DB_PASSWORD=your_password
ERP_DB_NAME=erp_database
ERP_DB_TYPE=mysql

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 认证（预留）
AUTH_ENABLED=false
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440

# Mock 模式（无 ERP 时使用模拟数据）
MOCK_MODE=true
